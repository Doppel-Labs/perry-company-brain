# One canonical toolchain for the Company Brain monorepo.
#
# pnpm is pinned via the root package.json "packageManager" field — run
# `corepack enable` once and pnpm matches it automatically. Always operate from
# the repo root (the workspace), never from inside a package or the inky/ subtree.
#
# Node 24 is the target (see .nvmrc / .node-version / engines), but engines are
# advisory here so installs don't hard-fail before the machine default is on 24.
engine-strict=false

# Link workspace packages (@perry/core <-> @inky/core) from the workspace, not
# the registry, even without an explicit version range.
link-workspace-packages=true
